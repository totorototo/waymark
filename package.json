{
  "name": "waymark",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Edit a race director's GPX: pin checkpoints on the map, set their cutoffs, export an extended GPX (Zig/WASM via Zigar).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:zig": "cd zig && zig build test --summary all",
    "test:all": "npm run test:zig && npm run test:run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@styled-icons/feather": "10.47.0",
    "@totorototo/trail-tokens": "github:totorototo/trail-tokens#v1.2.0",
    "mapbox-gl": "3.25.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-map-gl": "8.1.1",
    "styled-components": "^6.4.2",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "9.39.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "16.5.0",
    "jsdom": "27.2.0",
    "prettier": "3.7.4",
    "rollup-plugin-zigar": "^0.17.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.9",
    "workbox-precaching": "^7.4.1"
  }
}
